table Fact_Sales
	lineageTag: ef7b65ed-525f-4db4-9d31-4365be365010

	measure 'Running Total Sales' =
			
			CALCULATE(
			    [Total Sales],
			    FILTER(
			        ALLSELECTED(Dim_Date[date]),
			        Dim_Date[date] <= MAX(Dim_Date[date])
			    )
			)
		lineageTag: fa52317e-4b3c-4f25-9a04-8490c62d348c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'City Sales Rank' =
			
			RANKX(
			    ALLSELECTED(Dim_City[city]),
			    [Total Sales],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		lineageTag: f26d1a59-58c3-4b8e-bb5b-82fee66c7f22

	measure AOV =
			
			DIVIDE(
			    [Total Sales],
			    DISTINCTCOUNT(Fact_Sales[sale_id])
			)
		lineageTag: e72e68ee-a82e-4ef6-a877-b6edcea4889c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Sales' =
			
			SUM(Fact_Sales[sales_amount])
		lineageTag: 6ac634fc-da54-4438-8709-26c51ea01c00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column sale_id
		dataType: int64
		formatString: 0
